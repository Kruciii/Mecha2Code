# PostgreSQL używany przez MechaCode API
MECHACODE_DB_USER=admin
MECHACODE_DB_PASSWORD=change-me
MECHACODE_DB_NAME=mechacode_db

# Używane przez kontener API w docker-compose.yml.example
DATABASE_URL=postgresql+psycopg2://admin:change-me@mechacode-db:5432/mechacode_db
JUDGE0_URL=http://judge0-server:2358
JUDGE0_BATCH_SIZE=20
JWT_SECRET_KEY=replace-with-a-long-random-secret
